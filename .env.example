# Public values exposed to the Vite browser bundle.
# Set these in Vercel Project Settings for Preview and Production.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: URL of the separately deployed API service.
# Leave empty when the API is served from the same origin.
VITE_API_URL=
