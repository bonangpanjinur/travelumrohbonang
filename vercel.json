{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm run build:vercel",
  "outputDirectory": "artifacts/umroh-app/dist",
  "functions": {
    "api/[...all].mjs": {
      "includeFiles": "artifacts/api-server/dist/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...all].mjs" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
